# RepoSherpa environment variables
# Copy this to .env and fill in your keys

# Required: Gemini API key for Gemma 4 access
GEMINI_API_KEY=

# Recommended: GitHub personal access token (no scopes needed for public repos)
# Increases rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# Optional (P1): GitHub token with 'public_repo' scope for direct issue creation
GITHUB_WRITE_TOKEN=
